<?xml version="1.0" ?>

<installation xmlns="urn:jboss:galleon:provisioning:3.0">
    <feature-pack location="org.jboss.eap:wildfly-ee-galleon-pack:zip">
        <packages>
            <include name="docs.examples.configs"/>
        </packages>
    </feature-pack>
    <options>
        <option name="jboss-bulk-resolve-artifacts" value="true"/>
        <option name="jboss-fork-embedded" value="true"/>
        <option name="jboss-reset-embedded-system-properties" value=""/>
        <option name="jboss-resolved-artifacts-cache" value=".installation/.cache"/>
        <option name="print-only-conflicts" value="true"/>
        <option name="store-input-provisioning-config" value="true"/>
    </options>
</installation>